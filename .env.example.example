# ===== في Pterodactyl ضع هذه القيم في تبويب Startup / Variables بدل ملف .env =====
# توكن البوت — لا تشاركه مع أحد
DISCORD_TOKEN=
# معرّف المالك (يمكن أكثر من معرّف مفصولين بفاصلة)
OWNER_ID=
# اختياري: معرّفات أشخاص مسموح لهم باستخدام اللوحة (مفصولة بفاصلة)
ADMIN_IDS=
# اختياري: معرّفات رتب مسموح لها باستخدام اللوحة (مفصولة بفاصلة)
ADMIN_ROLE_IDS=
# اختياري: يمكن تحديدهما بالأمر /setup panel و /setup control بدل هذه المتغيرات
PANEL_CHANNEL_ID=
CONTROL_CHANNEL_ID=
# رابط صورة الشعار الثابت (يظهر بجانب كل رسالة وبجانب عنوان Broadcast Control). إن تُرك فارغًا يُستخدم avatar البوت
LOGO_URL=
# اختياري: رابط إيقاف البرودكاست يدويًا (افتراضيًا يُبنى تلقائيًا من رسالة Broadcast Control)
STOP_URL=
# الفاصل بين كل رسالة خاصة والتالية بالمللي ثانية (لا تنزله كثيرًا لتفادي حدود Discord)
DM_DELAY_MS=1500
# لغة اللوحة الافتراضية: ar أو en (يبدّلها زر اللغة في أي وقت)
DEFAULT_LANG=ar
# مكان قاعدة البيانات (يجب أن يكون على قرص دائم)
DB_PATH=./data/broadcast.sqlite

# ملاحظة: رابط الموقع وزر «مساعدة» ثابتان ومحميان داخل الكود،
# ولا يوجد لهما أي متغير هنا — لا في هذه النسخة ولا في النسخة المشفّرة.
